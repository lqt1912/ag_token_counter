{
  "name": "antigravity-token-counter",
  "productName": "AI Token Analytics",
  "version": "1.0.0",
  "description": "Real-time Pure Electron Windows System Tray AI Token Counter for Antigravity IDE",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "npx esbuild src/main/service.ts --bundle --platform=node --outfile=src/main/service.js --external:electron && electron .",
    "build": "npx esbuild src/main/service.ts --bundle --platform=node --outfile=src/main/service.js --external:electron",
    "build:portable": "tauri build --no-bundle && powershell -Command \"New-Item -ItemType Directory -Force dist-portable | Out-Null; Copy-Item src-tauri/target/release/ag-token-counter.exe dist-portable/AI-Token-Analytics.exe -Force\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "build": {
    "appId": "com.antigravity.tokencounter",
    "productName": "AI Token Analytics",
    "directories": {
      "output": "dist-portable"
    },
    "files": [
      "src/main/main.js",
      "src/main/service.js",
      "src/main/preload.js",
      "src/renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "chart.js": "^4.4.8",
    "js-tiktoken": "^1.0.21"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20.17.24",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "typescript": "^5.8.2"
  }
}
