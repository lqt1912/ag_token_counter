<Window x:Class="AntigravityTokenTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Width="560" Height="650" AllowsTransparency="False" Background="#F8FAFC"
        Deactivated="Window_Deactivated" SnapsToDevicePixels="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value>
      </Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E2E8F0"/><Setter Property="Foreground" Value="#0F172A"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#334155"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,7"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border Margin="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14">
    <Grid Margin="22,20,22,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="42" Height="42" CornerRadius="13" Background="#0F172A">
          <TextBlock Text="AG" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="AI Token Analytics" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
          <TextBlock Text="Antigravity local usage" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
        </StackPanel>
        <Button Grid.Column="2" Content="×" Style="{StaticResource GhostButton}" FontSize="22" Width="34" Height="34" Click="CloseBtn_Click"/>
      </Grid>

      <Border Grid.Row="1" Background="#0F172A" CornerRadius="14" Padding="17" Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="CURRENT SESSION" FontSize="10" FontWeight="SemiBold" Foreground="#67E8F9"/>
            <TextBlock x:Name="TxtSession" Text="Scanning..." FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
            <TextBlock x:Name="TxtSessionDetail" Text="--" FontSize="11" Foreground="#CBD5E1" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="PROCESSED ESTIMATE" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Right"/>
            <TextBlock x:Name="TxtHeroTotal" Text="0" FontSize="25" FontWeight="Bold" Foreground="#67E8F9" HorizontalAlignment="Right" Margin="0,2,0,0"/>
            <TextBlock Text="tokens" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="2" Margin="0,0,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#ECFDF5" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,0,6,0">
          <StackPanel><TextBlock Text="TODAY" FontSize="10" FontWeight="SemiBold" Foreground="#15803D"/><TextBlock x:Name="TxtToday" Text="0" FontSize="21" FontWeight="Bold" Foreground="#166534" Margin="0,4,0,0"/><TextBlock x:Name="TxtTodayDetail" Text="0 requests" FontSize="10" Foreground="#4D7C5A" Margin="0,2,0,0"/></StackPanel>
        </Border>
        <Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="11" Padding="12" Margin="3,0,3,0">
          <StackPanel><TextBlock Text="ALL TIME" FontSize="10" FontWeight="SemiBold" Foreground="#2563EB"/><TextBlock x:Name="TxtAllTime" Text="0" FontSize="21" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,4,0,0"/><TextBlock x:Name="TxtSessions" Text="0 sessions" FontSize="10" Foreground="#5278B7" Margin="0,2,0,0"/></StackPanel>
        </Border>
        <Border Grid.Column="2" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="11" Padding="12" Margin="6,0,0,0">
          <StackPanel><TextBlock Text="ACTIVE MODEL" FontSize="10" FontWeight="SemiBold" Foreground="#C2410C"/><TextBlock x:Name="TxtModel" Text="--" FontSize="14" FontWeight="Bold" Foreground="#9A3412" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/><TextBlock x:Name="TxtRequests" Text="0 requests" FontSize="10" Foreground="#A16207" Margin="0,3,0,0"/></StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="3">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,9">
          <StackPanel><TextBlock Text="MODEL BREAKDOWN" FontSize="11" FontWeight="Bold" Foreground="#334155"/><TextBlock Text="Estimated processed tokens by model" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/></StackPanel>
          <TextBlock Text="ALL TIME" DockPanel.Dock="Right" FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Bottom"/>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PanelModels"/></ScrollViewer>
      </Grid>

      <DockPanel Grid.Row="4" Margin="0,15,0,0">
        <TextBlock x:Name="TxtUpdated" Text="Not refreshed" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="↻  Refresh" Style="{StaticResource ActionButton}" Margin="0,0,7,0" Click="RefreshBtn_Click"/><Button Content="▣  Logs" Style="{StaticResource ActionButton}" Click="LogsBtn_Click"/></StackPanel>
      </DockPanel>
    </Grid>
  </Border>
</Window>
